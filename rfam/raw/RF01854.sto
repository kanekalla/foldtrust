#=GF DR GO; 0006617; SRP-dependent cotranslational protein targeting to membrane, signal sequence recognition;
#=GF DR GO; 0048501; signal recognition particle, plasma membrane targeting;
#=GF RN [1]
#=GF RM 12520023
#=GF RT SRPDB: Signal Recognition Particle Database.
#=GF RA Rosenblad MA, Gorodkin J, Knudsen B, Zwieb C, Samuelsson T
